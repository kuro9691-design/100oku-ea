"""指標テーブルCSVをしきい値でフィルタして押し目候補を出す（高速・繰り返し用）。

事前に scripts/build_indicator_table.py で作った素の指標テーブルを読み込み、
MA上・MA近接・安値切り上げ・下髭の各しきい値で候補を絞り込むだけ。再計算なしで一瞬。

Usage:
    python scripts/collect_candidates.py --table btc_candidate_indicators.csv
"""
from __future__ import annotations

import argparse
import csv
import json
from pathlib import Path


def evaluate(row: dict, wick_ratio_min: float, ma_proximity_pct: float) -> tuple[bool, bool, bool, bool, bool]:
    above_ma = float(row["close"]) > float(row["ma"])
    above_ma720 = float(row["close"]) > float(row["ma720"])
    ma_near = abs(float(row["ma_distance_pct"])) <= ma_proximity_pct
    has_wick = float(row["lower_wick_ratio"]) >= wick_ratio_min
    higher_low = row["higher_low"] == "yes"
    candidate = above_ma and above_ma720 and ma_near and higher_low and has_wick
    return above_ma, above_ma720, ma_near, has_wick, candidate


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--table", default="btc_candidate_indicators.csv")
    parser.add_argument("--wick-ratio", type=float, default=0.3, help="下髭/実体の最小比率（緩め）")
    parser.add_argument("--ma-proximity-pct", type=float, default=2.0, help="安値とMA80の距離許容（±%%、近いほど押し目らしい。離れすぎはブレイク型として除外）")
    parser.add_argument("--output", default="btc_pullback_candidates.csv")
    parser.add_argument("--summary-output", default="btc_pullback_candidates_summary.json")
    args = parser.parse_args()

    with Path(args.table).open(encoding="utf-8-sig", newline="") as handle:
        table = list(csv.DictReader(handle))

    counts = {"above_ma": 0, "above_ma720": 0, "ma_near": 0, "higher_low": 0, "has_wick": 0}
    candidates: list[dict] = []
    for row in table:
        above_ma, above_ma720, ma_near, has_wick, candidate = evaluate(row, args.wick_ratio, args.ma_proximity_pct)
        counts["above_ma"] += above_ma
        counts["above_ma720"] += above_ma720
        counts["ma_near"] += ma_near
{
