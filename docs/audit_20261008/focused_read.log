### PH-43: H1ダウ転換ポイントのブレイク 段階1(買いのみ)

- 登録日: 2026-07-28
//+------------------------------------------------------------------+
//|                                              BuyEA_d1ma20.mq4    |
//| BTC買いEA v1                                                     |
//| エントリー(H1バー確定時, shift=1, AND):                            |
//|   above_ma    : Close[1] > iMA(H1,80)                            |
//|   above_ma720 : Close[1] > iMA(H1,720)                           |
//|   ma_near     : abs(Low[1]-iMA(H1,80))/iMA(H1,80)*100 <= 1.0     |
//|   has_wick    : (min(Open,Close)-Low)/abs(Close-Open) >= 0.5     |
//|   d1_ma20     : 0 <= (Close[1]-iMA(D1,20,shift=1))/iMA*100 <= 2  |
//| 決済: SL=entry*0.98 / TP=entry*1.04(R=2.0) / 時間切れ200本(H1)     |
//+------------------------------------------------------------------+
#property strict

input double RiskPercent = 1.0;   // 1トレードあたりの口座資金リスク%（確定値）
input int    Slippage    = 30;    // 許容スリッページ（ポイント）
input int    MagicNumber = 100001;

// --- optional trend-follow score filter (H1/H4/D1 confirmed candles only) ---
input bool   UseTrendScoreFilter       = false;
input int    TrendScoreMin             = 8;      // max 12: H1/H4/D1 x 4 points
input bool   UseCandleSkipFilter       = true;   // E: candle-only no-trade filters
input int    TrendFastMaPeriod         = 20;
input int    TrendSlowMaPeriod         = 80;
input double MaxH1FastMaDistancePct    = 6.0;    // skip if H1 close is too far from MA20
input double StrongOppositeBodyRatio   = 0.60;   // skip on strong opposite H4/D1 candle

datetime lastBarTime = 0;

//+------------------------------------------------------------------+
int OnInit()
{
    lastBarTime = 0;
    return INIT_SUCCEEDED;
}

//+------------------------------------------------------------------+
void OnTick()
{
    if (Time[0] == lastBarTime) return;   // 新バーでなければ何もしない
    lastBarTime = Time[0];

    if (HasOpenPosition())
        ManageOpenPosition();
    else if (CheckEntry())
        OpenBuyOrder();
}

//+------------------------------------------------------------------+
bool HasOpenPosition()
{
    for (int i = OrdersTotal() - 1; i >= 0; i--)
    {
        if (!OrderSelect(i, SELECT_BY_POS, MODE_TRADES)) continue;
        if (OrderSymbol() == Symbol() && OrderMagicNumber() == MagicNumber && OrderType() == OP_BUY)
            return true;
    }
    return false;
}

//+------------------------------------------------------------------+
//| エントリー5条件をH1確定バー(shift=1)で判定                          |
//| 前提: このEAはH1チャートにアタッチされている                        |
//+------------------------------------------------------------------+
bool CheckEntry()
{
    double ma80   = iMA(NULL, PERIOD_H1, 80,  0, MODE_SMA, PRICE_CLOSE, 1);
    double ma720  = iMA(NULL, PERIOD_H1, 720, 0, MODE_SMA, PRICE_CLOSE, 1);
    double d1ma20 = iMA(NULL, PERIOD_D1, 20,  0, MODE_SMA, PRICE_CLOSE, 1);

    bool aboveMa    = Close[1] > ma80;
    bool aboveMa720 = Close[1] > ma720;

    double maDistPct = (Low[1] - ma80) / ma80 * 100.0;
    bool maNear = MathAbs(maDistPct) <= 1.0;

    double body = MathMax(MathAbs(Close[1] - Open[1]), 0.00000001);
    double wick = MathMin(Open[1], Close[1]) - Low[1];
    bool hasWick = (wick / body) >= 0.5;

    double d1DistPct = (Close[1] - d1ma20) / d1ma20 * 100.0;
    bool d1Ma20Ok = (d1DistPct >= 0.0 && d1DistPct <= 2.0);

    return aboveMa && aboveMa720 && maNear && hasWick && d1Ma20Ok && PassTrendScoreFilter(true);
}

bool PassTrendScoreFilter(bool isBuy)
{
    if (!UseTrendScoreFilter) return true;

    int score = TrendScore(isBuy);
    if (score < TrendScoreMin)
        return false;

    if (UseCandleSkipFilter && ShouldSkipByCandleFilters(isBuy))
        return false;

    return true;
}

int TrendScore(bool isBuy)
{
    return TrendFrameScore(PERIOD_H1, isBuy)
         + TrendFrameScore(PERIOD_H4, isBuy)
         + TrendFrameScore(PERIOD_D1, isBuy);
}

int TrendFrameScore(int timeframe, bool isBuy)
{
    double o = iOpen(Symbol(), timeframe, 1);
    double c = iClose(Symbol(), timeframe, 1);
    double fast1 = iMA(Symbol(), timeframe, TrendFastMaPeriod, 0, MODE_SMA, PRICE_CLOSE, 1);
    double fast2 = iMA(Symbol(), timeframe, TrendFastMaPeriod, 0, MODE_SMA, PRICE_CLOSE, 2);
    double slow1 = iMA(Symbol(), timeframe, TrendSlowMaPeriod, 0, MODE_SMA, PRICE_CLOSE, 1);
    if (fast1 <= 0 || fast2 <= 0 || slow1 <= 0) return 0;

    int score = 0;
    if (isBuy)
    {
        if (c > fast1) score++;
        if (fast1 > fast2) score++;
        if (c > slow1) score++;
        if (c > o) score++;
    }
    else
    {
        if (c < fast1) score++;
        if (fast1 < fast2) score++;
        if (c < slow1) score++;
        if (c < o) score++;
    }
    return score;
}

bool ShouldSkipByCandleFilters(bool isBuy)
{
    if (TooExtendedFromFastMa(PERIOD_H1))
        return true;

    if (StrongOppositeCandle(PERIOD_H4, isBuy))
        return true;

    if (StrongOppositeCandle(PERIOD_D1, isBuy))
        return true;

    return false;
}

bool TooExtendedFromFastMa(int timeframe)
{
    double c = iClose(Symbol(), timeframe, 1);
    double fast = iMA(Symbol(), timeframe, TrendFastMaPeriod, 0, MODE_SMA, PRICE_CLOSE, 1);
    if (fast <= 0) return false;

    double distPct = MathAbs(c - fast) / fast * 100.0;
    return (distPct > MaxH1FastMaDistancePct);
}

bool StrongOppositeCandle(int timeframe, bool isBuy)
{
    double o = iOpen(Symbol(), timeframe, 1);
    double c = iClose(Symbol(), timeframe, 1);
    double h = iHigh(Symbol(), timeframe, 1);
    double l = iLow(Symbol(), timeframe, 1);
    double range = h - l;
    if (range <= 0) return false;

    double bodyRatio = MathAbs(c - o) / range;
    if (bodyRatio < StrongOppositeBodyRatio) return false;

    if (isBuy) return (c < o);
    return (c > o);
}

//+------------------------------------------------------------------+
//| SL=entry*0.98(2%下) / TP=entry*1.04(SL距離×2.0上, R=2.0)          |
//| ロットはリスクベース（口座資金のRiskPercent%をSL幅で割って算出）       |
//+------------------------------------------------------------------+
void OpenBuyOrder()
{
    double entryPrice = NormalizeDouble(Ask, Digits);
    double risk = entryPrice * 0.02;
    double sl = NormalizeDouble(entryPrice - risk, Digits);
    double tp = NormalizeDouble(entryPrice + risk * 2.0, Digits);

    double slDistancePoints = (entryPrice - sl) / Point;
    double tickValue = MarketInfo(Symbol(), MODE_TICKVALUE);
    double riskAmount = AccountBalance() * RiskPercent / 100.0;
    double lot = riskAmount / (slDistancePoints * tickValue);

    double lotStep = MarketInfo(Symbol(), MODE_LOTSTEP);
    double minLot  = MarketInfo(Symbol(), MODE_MINLOT);
    double maxLot  = MarketInfo(Symbol(), MODE_MAXLOT);
    lot = MathFloor(lot / lotStep) * lotStep;
    lot = MathMax(minLot, MathMin(maxLot, lot));

    int ticket = OrderSend(
        Symbol(), OP_BUY, lot, entryPrice, Slippage,
        sl, tp, "BuyEA", MagicNumber, 0, clrBlue
    );
    if (ticket < 0)
        Print("OrderSend failed: ", GetLastError());
}

//+------------------------------------------------------------------+
//| 時間切れ200本(H1)で強制決済                                        |
//+------------------------------------------------------------------+
void ManageOpenPosition()
{
    for (int i = OrdersTotal() - 1; i >= 0; i--)
    {
        if (!OrderSelect(i, SELECT_BY_POS, MODE_TRADES)) continue;
        if (OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber) continue;
        if (OrderType() != OP_BUY) continue;

        int barsSinceEntry = iBarShift(Symbol(), PERIOD_H1, OrderOpenTime(), false);
        if (barsSinceEntry >= 200)
        {
            bool closed = OrderClose(OrderTicket(), OrderLots(), Bid, Slippage, clrRed);
            if (!closed)
                Print("OrderClose failed: ", GetLastError());
        }
    }
}
