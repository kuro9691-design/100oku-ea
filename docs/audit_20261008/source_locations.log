from pathlib import Path
from email import policy
from email.parser import BytesParser
from bs4 import BeautifulSoup
import sys

sources = sorted(Path('reference').glob('*.mhtml'))
out = Path('docs/realtrade_reading_20260905')
out.mkdir(exist_ok=True)
for i, source in enumerate(sources):
    msg = BytesParser(policy=policy.default).parsebytes(source.read_bytes())
    html = next(p for p in msg.walk() if p.get_content_type() == 'text/html')
    soup = BeautifulSoup(html.get_payload(decode=True).decode('utf-8'), 'html.parser')
    body = soup.select_one('.entry-content') or soup.select_one('article') or soup
    for tag in body.select('script, style, nav'):
        tag.decompose()
    text = body.get_text('\n', strip=True)
    if len(sys.argv) > 1 and int(sys.argv[1]) != i:
        continue
    print(f'ARTICLE {i}: {source.name}\n{text}\nEND ARTICLE {i}')
    folder = out / str(i)
    folder.mkdir(exist_ok=True)
    for j, p in enumerate(msg.walk()):
        if p.get_content_type().startswith('image/'):
            ext = {'image/jpeg': '.jpg', 'image/png': '.png', 'image/webp': '.webp'}.get(p.get_content_type())
            if ext:
                (folder / f'{j}{ext}').write_bytes(p.get_payload(decode=True))
                print(f'IMAGE {j}: {p.get("Content-Location", "")}')


