    def _stop_entry_fill(self, state: TimeframeState, direction: int) -> Pivot | None:
        """Return a pending stop order filled by the current bar.

        A stop order becomes active after a completed H1 bar satisfies D's
        trend, expansion, and MA-order setup. Prior touches cancel an active
        order, but a later completed setup may place a fresh order at the same
        still-valid pivot. Only the current bar is used for the fill check.
        """
        source = getattr(state.bars, "_values", state.bars)
        key = (id(source), direction)
        order = self._stop_order_cache.setdefault(
            key,
            {
                "processed": -1,
                "active": None,
                "placed_at": -1,
                "previous_setup_ready": False,
                "fills": {},
            },
        )
        kind = "high" if direction > 0 else "low"
        for index in range(order["processed"] + 1, state.index + 1):
            bar = state.bars[index]
            active = order["active"]
            if active is not None and index > order["placed_at"]:
                reached = bar.high >= active.price if direction > 0 else bar.low <= active.price
                if reached:
                    order["fills"][index] = active
                    order["active"] = None
            setup_ready = self._d_setup_ready_at(state.bars, index, direction)
            if setup_ready and not order["previous_setup_ready"]:
                pivots = confirmed_pivots(state.bars, index, self.params.N_h1)
                pivot = next((item for item in reversed(pivots) if item.kind == kind), None)
                if pivot is not None:
                    line_ahead = pivot.price > bar.close if direction > 0 else pivot.price < bar.close
                    if line_ahead:
                        order["active"] = pivot
                        order["placed_at"] = index
            order["previous_setup_ready"] = setup_ready
            order["processed"] = index
        return order["fills"].get(state.index)

    def _d_setup_ready_at(self, bars: Sequence[Bar], index: int, direction: int) -> bool:
        if index <= 0:
            return False
        key = (bars[index].timestamp, direction)
        cached = self._d_setup_cache.get(key)
        if cached is not None:
            return cached
        p = self.params
        pivots = confirmed_pivots(bars, index, p.N_h1)
        trend = trend_direction(pivots)
        fast = sma(bars, index, p.h1_fast_ma_period)
        slow = sma(bars, index, p.h1_slow_ma_period)
        previous_band = abs(
            sma(bars, index - 1, p.h1_fast_ma_period)
            - sma(bars, index - 1, p.h1_slow_ma_period)
        )
        band = abs(fast - slow)
        ma_ordered = (direction > 0 and fast > slow) or (direction < 0 and fast < slow)
        ready = trend == direction and band > previous_band and ma_ordered
        self._d_setup_cache[key] = ready
        return ready

    def _breakout(self, state: TimeframeState, close: float, direction: int) -> bool:
        # Compatibility helper for diagnostics; breakout is now a causal
        # pending-stop fill rather than a close beyond the pivot.
        return self._stop_entry_fill(state, direction) is not None

    @staticmethod
    def _nested(h4: TimeframeState, h1: TimeframeState) -> bool:
        if not h4.pivots or not h1.pivots:
            return False

    def test_stop_entry_fills_at_confirmed_pivot_on_first_later_touch(self):
        pipeline = DecisionPipeline(Params(N_h1=1))
        state = self._state(trend=1, fast_ma=101, fast_slope=1)
        timestamps = [
            datetime(2026, 1, day, tzinfo=timezone.utc)
            for day in range(1, 5)
        ]
        state.bars = [
            Bar(timestamps[0], 99, 100, 98, 99),
            Bar(timestamps[1], 99, 101, 98, 100),
            Bar(timestamps[2], 99, 100, 98, 99),
            Bar(timestamps[3], 99, 101, 98, 100),
        ]
        state.index = 3
        state.pivots = [Pivot(1, timestamps[1], 101, "high")]
        with patch.object(pipeline, "_d_setup_ready_at", side_effect=lambda bars, index, direction: index == 2):
            fill = pipeline._stop_entry_fill(state, 1)
        self.assertIsNotNone(fill)
        self.assertEqual(fill.price, 101)

    def test_stop_entry_does_not_fill_twice_at_same_pivot(self):
        pipeline = DecisionPipeline(Params(N_h1=1))
        state = self._state(trend=1, fast_ma=101, fast_slope=1)
        timestamps = [
            datetime(2026, 1, day, tzinfo=timezone.utc)
            for day in range(1, 6)
        ]
        state.bars = [
            Bar(timestamps[0], 99, 100, 98, 99),
            Bar(timestamps[1], 99, 101, 98, 100),
            Bar(timestamps[2], 99, 100, 98, 99),
            Bar(timestamps[3], 99, 101, 98, 100),
            Bar(timestamps[4], 99, 102, 98, 101),
        ]
        state.index = 4
        state.pivots = [Pivot(1, timestamps[1], 101, "high")]
        with patch.object(pipeline, "_d_setup_ready_at", side_effect=lambda bars, index, direction: index == 2):
            self.assertIsNone(pipeline._stop_entry_fill(state, 1))

    def test_d_requires_ma720_slope_aligned(self):
        pipeline = DecisionPipeline()
        d1 = self._state(trend=1, fast_ma=101, fast_slope=1)
        h4 = self._state(trend=1, fast_ma=101, fast_slope=1)
        dummy_pivot = Pivot(0, datetime(2026, 1, 1, tzinfo=timezone.utc), 105, "high")

        h1_up = self._state(trend=1, fast_ma=101, fast_slope=1)
        h1_up.direction_slope = 0.1  # MA720 上向き → long と一致
        with patch.object(pipeline, "_stop_entry_fill", return_value=dummy_pivot):
            self.assertTrue(
                pipeline._score_direction(1, d1, h4, h1_up, 0.0)["criteria"]["D"].passed
            )

        h1_dn = self._state(trend=1, fast_ma=101, fast_slope=1)
        h1_dn.direction_slope = -0.1  # MA720 下向き → long と不一致
        with patch.object(pipeline, "_stop_entry_fill", return_value=dummy_pivot):
            self.assertFalse(
                pipeline._score_direction(1, d1, h4, h1_dn, 0.0)["criteria"]["D"].passed
            )

        h1_flat = self._state(trend=1, fast_ma=101, fast_slope=1)
        h1_flat.direction_slope = 0.0  # MA720 横ばい → 不一致（レンジ除外）
        with patch.object(pipeline, "_stop_entry_fill", return_value=dummy_pivot):
            self.assertFalse(
                pipeline._score_direction(1, d1, h4, h1_flat, 0.0)["criteria"]["D"].passed
            )

    def test_stop_entry_can_be_rearmed_after_an_earlier_touch(self):
        pipeline = DecisionPipeline(Params(N_h1=1))
        state = self._state(trend=1, fast_ma=101, fast_slope=1)
        timestamps = [
            datetime(2026, 1, day, tzinfo=timezone.utc)
            for day in range(1, 7)
        ]
        state.bars = [
            Bar(timestamps[0], 99, 100, 98, 99),
            Bar(timestamps[1], 99, 101, 98, 100),
            Bar(timestamps[2], 99, 100, 98, 99),
            Bar(timestamps[3], 99, 101, 98, 100),
            Bar(timestamps[4], 99, 100, 98, 99),
            Bar(timestamps[5], 99, 102, 98, 101),
        ]
        state.index = 5
        state.pivots = [Pivot(1, timestamps[1], 101, "high")]
        with patch.object(pipeline, "_d_setup_ready_at", side_effect=lambda bars, index, direction: index == 4):
            self.assertIsNotNone(pipeline._stop_entry_fill(state, 1))

    @staticmethod
    def _state(trend: int, fast_ma: float, fast_slope: float) -> TimeframeState:
        bar = Bar(datetime(2026, 1, 1, tzinfo=timezone.utc), 100, 101, 99, 100)
        return TimeframeState(
            bars=[bar],
            index=0,
            pivots=[],
            trend=trend,
            atr=1,
            fast_ma=fast_ma,
            fast_ma_slope=fast_slope,
            slow_ma=100,
